<%# This is the LAYOUT — it wraps every page in the app. %>
<%# Think of it as the shared frame: navbar, <head> tags, Bootstrap, etc. go here. %>
<%# The actual page content (index.html.erb or show.html.erb) is injected by `yield` below. %>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Airbnb Static" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Airbnb Static">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# This loads Bootstrap from a CDN (Content Delivery Network) — a remote server.%>
    <%#    Because it's in the layout, Bootstrap is available on EVERY page automatically. %>
    <%#    `rel="stylesheet"` tells the browser it's a CSS file. %>
    <%#   The `integrity` attribute is a security check: the browser verifies the file %>
    <%#   hasn't been tampered with before using it. %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3"
      crossorigin="anonymous">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <%# yield is where the current page view gets inserted.  %>
    <%#   When you visit /, Rails puts index.html.erb here. %>
    <%# When you visit /flats/3, Rails puts show.html.erb here. %>
     <div class="container">

      <%= yield %>

      <p> This was mande by Gabi in a le wagon live code </p>
    </div>
  </body>
</html>
